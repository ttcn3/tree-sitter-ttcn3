{
  "name": "tree-sitter-ttcn3",
  "version": "0.2.1",
  "description": "TTCN-3 grammar for tree-sitter",
  "repository": "https://github.com/ttcn3/tree-sitter-ttcn3",
  "license": "MIT",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "ttcn3"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "./node_modules/.bin/tree-sitter generate && ./node_modules/.bin/tree-sitter test"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.11"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "scripts/*",
    "*.wasm",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "source.ttcn3",
      "injection-regex": "^ttcn3$"
    }
  ]
}
